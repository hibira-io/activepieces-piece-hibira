{
  "name": "@hibira-io/piece-hibira",
  "version": "0.2.0",
  "description": "Hibira piece for Activepieces: realtime events, presence, push notifications and a webhook trigger",
  "keywords": [
    "activepieces",
    "activepieces-piece",
    "hibira",
    "pusher",
    "realtime",
    "websocket",
    "push-notifications"
  ],
  "homepage": "https://hibira.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibira-io/activepieces-piece-hibira.git"
  },
  "bugs": {
    "url": "https://github.com/hibira-io/activepieces-piece-hibira/issues"
  },
  "license": "MIT",
  "author": "Hibira",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.lib.json && cp -r src/i18n dist/src/",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@activepieces/pieces-common": "^0.12.5",
    "@activepieces/pieces-framework": "^0.32.0",
    "@activepieces/shared": "^0.95.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "~5.6.3",
    "vitest": "^3.2.4"
  }
}
